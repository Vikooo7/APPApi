	partition fact_envio = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "fact_envio.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    SinVacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(SinVacios, {{"envio_id", Int64.Type}, {"fecha_key", Int64.Type}, {"ruta_key", Int64.Type}, {"zona_key", Int64.Type}, {"courier_key", Int64.Type}, {"remitente_key", Int64.Type}, {"peso_kg", type number}, {"costo_envio", type number}, {"contraentrega", Int64.Type}, {"monto_contraentrega", type number}, {"intentos", Int64.Type}, {"entregado", Int64.Type}, {"devuelto", Int64.Type}, {"horas_entrega", type number}, {"a_tiempo", Int64.Type}, {"km_courier", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

