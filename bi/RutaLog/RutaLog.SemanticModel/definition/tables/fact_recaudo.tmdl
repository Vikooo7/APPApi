	partition fact_recaudo = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "fact_recaudo.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    SinVacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(SinVacios, {{"envio_id", Int64.Type}, {"remitente_key", Int64.Type}, {"fecha_cobro_key", Int64.Type}, {"fecha_liquidacion_key", Int64.Type}, {"recaudado", type number}, {"costo_envio", type number}, {"neto", type number}, {"dias_hasta_liquidar", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

