table dim_motivo_falla
	lineageTag: efb7d34b-0519-5569-a977-b1e88e74f80b

	column motivo_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: aac46756-e52b-5428-a936-fa6c34f904bd
		summarizeBy: none
		sourceColumn: motivo_key

		annotation SummarizationSetBy = Automatic

	column motivo
		dataType: string
		lineageTag: 101d7e17-a01c-5900-b26c-3694be3ecb27
