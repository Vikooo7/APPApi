	partition dim_franja = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "dim_franja.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    SinVacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(SinVacios, {{"franja_key", Int64.Type}, {"franja", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

