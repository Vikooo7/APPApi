				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    SinVacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(SinVacios, {{"fecha_key", Int64.Type}, {"fecha", type date}, {"anio", Int64.Type}, {"mes_num", Int64.Type}, {"mes", type text}, {"semana", Int64.Type}, {"semana_label", type text}, {"inicio_semana", type date}, {"dia_num", Int64.Type}, {"dia", type text}, {"fin_de_semana", type text}, {"periodo_aviso", type text}, {"campana", type text}}, "en-US")
				in
