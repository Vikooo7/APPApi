	partition fact_intento = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "fact_intento.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    SinVacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(SinVacios, {{"intento_id", Int64.Type}, {"envio_id", Int64.Type}, {"fecha_key", Int64.Type}, {"franja_key", Int64.Type}, {"zona_key", Int64.Type}, {"courier_key", Int64.Type}, {"motivo_key", Int64.Type}, {"numero_intento", Int64.Type}, {"contraentrega", Int64.Type}, {"confirmo_horario", Int64.Type}, {"confirmacion", type text}, {"aviso_previo", Int64.Type}, {"fallo", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
